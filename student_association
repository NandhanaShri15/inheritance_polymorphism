
class Student:
    def getdetails(self):
        self.rn=int(input("Enter roll no. :"))
        self.n=input("Enter name:")
        self.tm=int(input("Enter test mark:"))
    def total_marks(self):
        self.total=self.tm
    def display(self):
        print("Roll no. :",self.rn)
        print("Name:",self.n)
        print("Test mark:",self.tm)
class Literary_student(Student):
    def getlitmark(self):
        super().getdetails()
        self.lm=int(input("Enter mark of literary association particiption:"))
    def total_marks(self):
        super().total_marks()
        self.total+=self.lm
    def display(self):
        super().display()
        print("Literary association mark:",self.lm)
        print("Total marks:",self.total)
class sports_student(Student):
    def getspmark(self):
        super().getdetails()
        self.sm=int(input("Enter sports mark:"))
    def total_marks(self):
        super().total_marks()
        self.total+=self.sm
    def display(self):
        super().display()
        print("Sports mark:",self.sm)
        print("Total marks:",self.total)
class Lit_Sport_Student(Student):
    def getlit_spmark(self):
        super().getdetails()
        self.lm=int(input("Enter mark of literary association participation:"))
        self.sm=int(input("Enter sports mark:"))
    def total_marks(self):
        super().total_marks()
        self.total=self.total+self.lm+self.sm
    def display(self):
        super().display()
        print("Literary association marl:",self.lm)
        print("Sports mark:",self.sm)
        print("Total mark:",self.total)
